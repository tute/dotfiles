# Setup 'v' to begin selection as in Vim
bind-key -N "Begin selection" -Tcopy-mode-vi 'v' send -X begin-selection
# bind-key -Tcopy-mode-vi 'y' send -X copy-pipe "reattach-to-user-namespace pbcopy"
bind-key -N "Cancel selection" -Tcopy-mode-vi Escape send -X cancel
bind-key -N "Toggle rectangle selection" -Tcopy-mode-vi V send -X rectangle-toggle

# Easy resize of panes
bind -N "Resize pane left" -r H resize-pane -L 5
bind -N "Resize pane down" -r J resize-pane -D 5
bind -N "Resize pane up" -r K resize-pane -U 5
bind -N "Resize pane right" -r L resize-pane -R 5

bind -N "Split pane horizontally" | split-window -h -c "#{pane_current_path}"
bind -N "Split pane vertically" - split-window -v -c "#{pane_current_path}"

# smart pane switching with awareness of vim splits
bind -N "Focus pane left (vim aware)" -n C-h run "(tmux display-message -p '#{pane_current_command}' | grep -iq vim && tmux send-keys C-h) || tmux select-pane -L"
bind -N "Focus pane down (vim aware)" -n C-j run "(tmux display-message -p '#{pane_current_command}' | grep -iq vim && tmux send-keys C-j) || tmux select-pane -D"
bind -N "Focus pane up (vim aware)" -n C-k run "(tmux display-message -p '#{pane_current_command}' | grep -iq vim && tmux send-keys C-k) || tmux select-pane -U"
bind -N "Focus pane right (vim aware)" -n C-l run "(tmux display-message -p '#{pane_current_command}' | grep -iq vim && tmux send-keys C-l) || tmux select-pane -R"
# bind -n C-\ run "(tmux display-message -p '#{pane_current_command}' | grep -iq vim && tmux send-keys 'C-\\') || tmux select-pane -l"

# Keep clear command
bind -N "Clear screen" C-l send-keys 'C-l'

bind-key -N "Kill pane" -n M-x confirm-before "kill-pane"
bind-key -N "Enter copy mode" -n M-/ copy-mode


# System clipboard
if-shell 'uname | grep -q Darwin' \
  'bind -N "Copy selection" -T copy-mode-vi Enter send -X copy-pipe-and-cancel "pbcopy" ; bind -N "Copy mouse selection" -T copy-mode-vi MouseDragEnd1Pane send -X copy-pipe-and-cancel "pbcopy"' \
  'bind -N "Copy selection" -T copy-mode-vi Enter send -X copy-pipe-and-cancel "wl-copy" ; bind -N "Copy mouse selection" -T copy-mode-vi MouseDragEnd1Pane send -X copy-pipe-and-cancel "wl-copy"'
